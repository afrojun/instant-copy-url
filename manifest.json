{
  "manifest_version": 3,
  "name": "Instant Copy URL",
  "version": "1.8.0",
  "description": "Copy tab URLs instantly. One shortcut or a right-click copies the current or selected tabs, or a whole tab group.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "tabGroups", "clipboardWrite", "offscreen", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "commands": {
    "copy-current-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current or selected tab URLs"
    }
  }
}
