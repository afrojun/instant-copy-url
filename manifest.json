{
  "manifest_version": 3,
  "name": "Instant Copy URL",
  "version": "1.7.0",
  "description": "Copy a tab URL with a shortcut, or move it to another Chrome profile with ProfileBar on Mac.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "clipboardWrite", "offscreen", "scripting", "contextMenus"],
  "optional_permissions": ["nativeMessaging", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "commands": {
    "copy-current-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current tab URL"
    }
  }
}
